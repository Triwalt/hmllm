Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  hicpp-*,
  modernize-*,
  performance-*,
  readability-*
WarningsAsErrors: ''
HeaderFilterRegex: 'kylin-messenger/.*'
FormatStyle: google
User: {}
CheckOptions:
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.VariableCase
    value:           camelBack
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'

